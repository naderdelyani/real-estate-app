{
  "name": "property-service",
  "version": "1.0.0",
  "description": "Property CRUD microservice with image upload and Prisma ORM",
  "main": "src/index.js",
  "scripts": {
    "dev":           "nodemon src/index.js",
    "start":         "node src/index.js",
    "lint":          "eslint src/**/*.js",
    "test":          "jest --coverage",
    "db:migrate":    "prisma migrate deploy",
    "db:generate":   "prisma generate",
    "db:studio":     "prisma studio"
  },
  "dependencies": {
    "express":           "^4.19.2",
    "@prisma/client":    "^5.14.0",
    "minio":             "^7.1.3",
    "multer":            "^1.4.5-lts.1",
    "sharp":             "^0.33.4",
    "amqplib":           "^0.10.4",
    "ioredis":           "^5.3.2",
    "jsonwebtoken":      "^9.0.2",
    "express-validator": "^7.1.0",
    "express-rate-limit":"^7.3.1",
    "helmet":            "^7.1.0",
    "cors":              "^2.8.5",
    "morgan":            "^1.10.0",
    "dotenv":            "^16.4.5",
    "uuid":              "^9.0.1"
  },
  "devDependencies": {
    "prisma":   "^5.14.0",
    "nodemon":  "^3.1.2",
    "jest":     "^29.7.0",
    "supertest":"^7.0.0",
    "eslint":   "^8.57.0"
  }
}
